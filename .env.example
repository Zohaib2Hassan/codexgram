# Copy to .env.local. Only these public values are embedded in the client.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
# Set in Convex deployment environment, NEVER as EXPO_PUBLIC variables:
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev
# CLERK_SECRET_KEY=...
# ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_ORIGINS=http://localhost:8081,https://your-admin-host.example
# PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=...
